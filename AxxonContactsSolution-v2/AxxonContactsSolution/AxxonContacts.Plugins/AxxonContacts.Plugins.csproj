<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>AxxonContacts.Plugins</RootNamespace>
    <AssemblyName>AxxonContacts.Plugins</AssemblyName>
    <Company>Axxon Consulting</Company>
    <Version>2.0.0</Version>
    <Description>Plugin thin - publica eventos de Contact a Azure Service Bus</Description>

    <!-- Strong Name obligatorio para Dataverse Sandbox -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>AxxonContacts.Plugins.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Net.Http no se referencia automaticamente en net462 -->
    <Reference Include="System.Net.Http" />
    <!-- Unico paquete requerido: SDK de Dataverse/CRM -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.51" />
    <!--
      NO se agregan paquetes adicionales para Service Bus.
      Usamos HttpClient (disponible en .NET 4.6.2) con la REST API de Service Bus
      y SAS token generado en codigo. Esto evita ILMerge y mantiene el assembly liviano.
    -->
  </ItemGroup>

</Project>
